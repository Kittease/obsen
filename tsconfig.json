{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "build/**/*.ts", "vitest.config.ts"],
  // `tests/wdio` has its own project: its Mocha and WebdriverIO globals have no
  // business being visible to the vitest suites.
  "exclude": ["node_modules", "prototypes", "tests/wdio"]
}
